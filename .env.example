# API endpoint used by the dashboard.
# In Vercel, prefer the same-origin proxy path so the frontend can call the backend without mixed-content or CORS errors.
VITE_API_BASE_URL=/api/v1

# Temporary local testing token. Do not commit real tokens.
VITE_ENABLE_DEV_AUTH=false
VITE_DEV_ACCESS_TOKEN=

# Disabled legacy demo: Google Maps URL input -> iframe preview.
VITE_ENABLE_GOOGLE_MAPS_LINK_DEMO=false
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Free Geoapify key (no credit card) for the Settings location picker: a clearer map and
# place search as you type. Leave empty to use OpenStreetMap + Nominatim (search on Enter).
# Get one at https://myprojects.geoapify.com and limit it to your website addresses.
VITE_GEOAPIFY_API_KEY=
